{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Fast Compile & Run (C++20)",
            "type": "shell",
            "command": "g++ -std=c++20 -O2 -Wall -fsyntax-only ${file} && g++ -std=c++20 -O2 -Wall ${file} -o ${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe && ${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe < ${workspaceFolder}\\input.txt > ${workspaceFolder}\\output.txt",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": false
            },
            "problemMatcher": [],
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/C"]
                }
            }
        }
    ]
}